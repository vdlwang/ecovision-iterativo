@startuml EcoVision - Fluxo de Dados em Tempo Real
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 12

title EcoVision - Fluxo de Dados do Sistema de Detecção e Separação

' ==================== ENTRADA DE DADOS ====================

rectangle "ENTRADA" #EDFEF4 {
  agent "Webcam\n(1920x1080 @ 30fps)" as Webcam #034732
  
  note right of Webcam
    Captura vídeo ao vivo
    do material na esteira
  end note
}

' ==================== PROCESSAMENTO FRONTEND ====================

rectangle "FRONTEND" #ABF2AB {
  component "CameraFeed\nComponent" as CameraFeed {
    [Canvas]
    [Video Element]
    [Refs & State]
  }
  
  component "Detection\nLoop" as DetectionLoop {
    [setInterval(3s)]
    [Capture Frame]
  }
  
  note right of DetectionLoop
    Loop executa a cada 3 segundos
    enquanto câmera estiver ativa
  end note
}

' ==================== API REST ====================

cloud "SUPABASE EDGE FUNCTION" #008148 {
  component "POST /modelo/processar" as ProcessAPI {
    [Recebe Frame]
    [Recebe gateConfigs]
  }
}

' ==================== PROCESSAMENTO BACKEND ====================

rectangle "BACKEND - MODELO IA" #196626 {
  component "ModeloIA.preverFrame()" as Predicao {
    [Inferência YOLO]
    [Detecção de Objetos]
    [Bounding Boxes]
  }
  
  component "OutputData" as Output {
    classePrevista: string
    confianca: number
  }
  
  component "ModeloIA.decidirAcionamento()" as Decisao {
    [Verifica confiança >= limite]
    [Compara com gateConfigs]
    [Retorna boolean]
  }
  
  note right of Output
    Exemplo:
    classe: "plastico"
    confianca: 92.5
  end note
}

' ==================== LÓGICA DE DECISÃO ====================

rectangle "LÓGICA DE CONTROLE" #FEF4ED {
  
  hexagon "confianca >= limiteMinAccuracy?" as CheckConfianca #D2B91F
  hexagon "material == gateConfig?" as CheckMaterial #D2B91F
  
  component "ModeloIA.executarAcionamento()" as Acionamento {
    [Abre Cancela]
    [Aguarda 2s]
    [Fecha Cancela]
  }
}

' ==================== CONTROLE FÍSICO ====================

rectangle "HARDWARE - CONTROLE SERIAL" #163B6F {
  component "ControladorSerial" as Serial {
    [Porta: /dev/ttyUSB0]
    [Baud: 9600]
  }
  
  component "Comandos" as Comandos {
    ABRIR_CANCELA_X
    FECHAR_CANCELA_X
  }
}

' ==================== ATUADORES ====================

rectangle "ATUADORES FÍSICOS" #FFF9E8 {
  component "ESP32" as ESP32 {
    [Recebe Serial]
    [Interpreta Bits]
  }
  
  rectangle "Cancelas" {
    agent "Cancela 1\n(Papel)" as Cancela1 #163B6F
    agent "Cancela 2\n(Plástico)" as Cancela2 #DC1F2E
    agent "Cancela 3\n(Metal)" as Cancela3 #196626
  }
}

' ==================== PERSISTÊNCIA ====================

database "BANCO DE DADOS" #E8F4FD {
  component "BancoDeDados.registrarProcessamento()" as RegistroDB {
    [material]
    [precisao]
    [cancelaId]
    [timestamp]
  }
  
  storage "KV Store\nPostgreSQL" as KVStore {
    processamento_{id}
  }
}

' ==================== FEEDBACK VISUAL ====================

rectangle "SAÍDA VISUAL" #EDFEF4 {
  component "Canvas Overlay" as Canvas {
    [Desenha Bounding Box]
    [Exibe Label]
    [Exibe Confiança]
  }
  
  component "Toast\nNotification" as Toast {
    "Material X detectado
    na Cancela Y"
  }
  
  note right of Canvas
    Bounding box colorido
    conforme material:
    • Papel: Azul #163B6F
    • Metal: Verde #196626
    • Plástico: Vermelho #DC1F2E
    • Vidro: Amarelo #D2B91F
  end note
}

' ==================== FLUXO PRINCIPAL ====================

Webcam --> CameraFeed : "Video Stream\n(MediaDevices API)"
CameraFeed --> DetectionLoop : "Inicia loop"
DetectionLoop --> ProcessAPI : "Frame + Configs\n(HTTP POST)"

ProcessAPI --> Predicao : "frame"
Predicao --> Output : "cria"
Output --> Decisao : "pred, configs, gateId"

Decisao --> CheckConfianca : "verifica"
CheckConfianca --> CheckMaterial : "✓ >= limite (85%)"
CheckConfianca --> ProcessAPI : "✗ < limite\nRejeita"

CheckMaterial --> Acionamento : "✓ match\nAciona cancela"
CheckMaterial --> ProcessAPI : "✗ no match\nTenta próxima"

Acionamento --> Serial : "comandos"
Serial --> Comandos : "formata"
Comandos --> ESP32 : "Serial (9600 baud)"

ESP32 --> Cancela1 : "GPIO Signal"
ESP32 --> Cancela2 : "GPIO Signal"
ESP32 --> Cancela3 : "GPIO Signal"

Acionamento --> RegistroDB : "salva evento"
RegistroDB --> KVStore : "persiste"

ProcessAPI --> CameraFeed : "Response JSON\n{classe, confianca, acionamentos}"
CameraFeed --> Canvas : "drawBoxes()"
CameraFeed --> Toast : "exibe notificação"

' ==================== FLUXO DE DADOS PARALELO ====================

rectangle "DASHBOARD (Paralelo)" #ABF2AB {
  component "StatisticsPanel" as Stats
  component "Gráficos\nRechartsKV Store" as Charts
}

KVStore -.-> Stats : "GET /dashboard/stats\n(polling 10s)"
Stats -.-> Charts : "atualiza visualização"

' ==================== CONFIGURAÇÕES ====================

rectangle "CONFIGURAÇÕES (Estado)" #008148 {
  storage "system_config" as Config {
    minAccuracy: 85
    modelVersion: "YOLOv8n"
    gateConfigs: {
      1: "papel"
      2: "plastico"
      3: "metal"
    }
  }
}

Config -.-> Decisao : "lê configurações"
Config -.-> ProcessAPI : "lê configurações"

' ==================== LEGENDA COM MÉTRICAS ====================

legend right
  **Métricas de Performance:**
  • **FPS da Câmera**: 30 fps
  • **Frequência de Detecção**: 1x a cada 3s
  • **Tempo de Acionamento**: ~2 segundos
  • **Taxa de Atualização Dashboard**: 10 segundos
  • **Limite de Confiança Padrão**: 85%
  
  **Cores dos Materiais:**
  |<#163B6F>  | Papel/Papelão |
  |<#196626>  | Metal |
  |<#DC1F2E>  | Plástico |
  |<#D2B91F>  | Vidro |
  
  **Fluxo de Dados:**
  —> Fluxo principal (síncrono)
  ..> Fluxo secundário (assíncrono)
endlegend

' ==================== ANOTAÇÕES DE TIMING ====================

note top of DetectionLoop
  **TIMING CRÍTICO**
  Loop de detecção: 3000ms
  Permite esteira avançar
  entre detecções
end note

note bottom of Acionamento
  **SEQUÊNCIA DE ACIONAMENTO**
  1. Abre cancela (GPIO HIGH)
  2. Delay 2000ms
  3. Fecha cancela (GPIO LOW)
  
  Material cai durante abertura
end note

note bottom of KVStore
  **ESTRUTURA DE DADOS**
  ```json
  {
    "id": 1699123456789,
    "material": "plastico",
    "precisao": 92.5,
    "cancela_id": 2,
    "data": "2025-11-08T10:30:45.789Z"
  }
  ```
end note

@enduml
