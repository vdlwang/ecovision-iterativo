@startuml EcoVision - Diagrama de Sequência
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 12

title EcoVision - Fluxo de Operação Completo

actor "Usuário" as User
participant "Login" as Login
participant "App.tsx" as App
participant "Sidebar" as Sidebar
participant "MonitorPanel" as Monitor
participant "CameraFeed" as Camera
participant "GateConfiguration" as GateConfig
participant "AccuracyControl" as AccuracyCtrl
participant "StatisticsPanel" as StatsPanel
participant "UserProfile" as Profile
participant "ONNX Runtime" as ONNX
participant "Supabase Auth" as Auth
participant "Server API" as Server
participant "KV Store" as KV

' ==================== FLUXO 1: LOGIN ====================

group 1. Login e Autenticação
  User -> Login : Acessa aplicação
  activate Login
  
  alt Google OAuth
    User -> Login : Clica "Login com Google"
    Login -> Auth : signInWithOAuth({provider: 'google'})
    activate Auth
    Auth --> Login : session + access_token
    deactivate Auth
    Login -> App : setUser(user), setUserToken(token)
  else Modo Demo
    User -> Login : Clica "Modo Demo"
    Login -> App : handleDemoMode()
    activate App
    App -> App : setIsDemoMode(true)\nsetUser(demo)\nsetUserToken(DEMO_TOKEN)
    deactivate App
  end
  
  deactivate Login
end

' ==================== FLUXO 2: CONFIGURAÇÃO ====================

group 2. Configuração Inicial

  User -> Sidebar : Seleciona aba "Cancelas"
  activate Sidebar
  Sidebar -> App : onTabChange("cancelas")
  deactivate Sidebar
  activate App
  App -> GateConfig : Renderiza componente
  deactivate App
  activate GateConfig
  
  User -> GateConfig : Define materiais:\nCancela 1 = papel\nCancela 2 = plástico\nCancela 3 = metal
  GateConfig -> App : onConfigChange({ 1: "papel", 2: "plastico", 3: "metal" })
  activate App
  App -> App : setGateConfigs(configs)
  App -> Server : POST /config\n{ gateConfigs, minAccuracy, modelVersion }
  activate Server
  Server -> KV : set("config_user123", {...})
  activate KV
  KV --> Server : success
  deactivate KV
  Server --> App : { success: true, config: {...} }
  deactivate Server
  deactivate App
  deactivate GateConfig
  
  User -> Sidebar : Seleciona aba "Modelo"
  activate Sidebar
  Sidebar -> App : onTabChange("modelo")
  deactivate Sidebar
  activate App
  App -> AccuracyCtrl : Renderiza componente
  deactivate App
  activate AccuracyCtrl
  
  User -> AccuracyCtrl : Ajusta confiança = 90%\nSeleciona YOLOv8n
  AccuracyCtrl -> App : onAccuracyChange(90)\nonModelVersionChange("YOLOv8n")
  activate App
  App -> App : setMinAccuracy(90)\nsetModelVersion("YOLOv8n")
  App -> Server : POST /config\n{ gateConfigs, minAccuracy: 90, modelVersion: "YOLOv8n" }
  activate Server
  Server -> KV : set("config_user123", {...})
  activate KV
  KV --> Server : success
  deactivate KV
  Server --> App : { success: true }
  deactivate Server
  deactivate App
  deactivate AccuracyCtrl
  
end

' ==================== FLUXO 3: MONITORAMENTO ====================

group 3. Monitoramento em Tempo Real

  User -> Sidebar : Seleciona aba "Monitor"
  activate Sidebar
  Sidebar -> App : onTabChange("monitor")
  deactivate Sidebar
  activate App
  App -> Monitor : Renderiza componente
  deactivate App
  activate Monitor
  Monitor -> Camera : Renderiza CameraFeed (inline)
  activate Camera
  
  User -> Camera : Clica "Iniciar Sistema"
  Camera -> App : onToggleSystem()
  activate App
  App -> App : setIsSystemRunning(true)
  App --> Camera : isRunning = true
  deactivate App
  
  Camera -> Camera : Solicita permissão da câmera
  Camera -> Camera : navigator.mediaDevices.getUserMedia()
  Camera --> Camera : stream de vídeo
  
  alt Inferência ONNX (Preferido)
    Camera -> ONNX : loadModel("/models/yolov8n.onnx")
    activate ONNX
    ONNX --> Camera : session pronta
    
    loop A cada frame (30-60 FPS)
      Camera -> Camera : Captura frame do vídeo
      Camera -> ONNX : runInference(session, imageData)
      ONNX -> ONNX : Pré-processamento (640x640, normalize)
      ONNX -> ONNX : Executa modelo
      ONNX -> ONNX : Pós-processamento (NMS, threshold)
      ONNX --> Camera : detections[]
      
      alt Detecção encontrada com confiança >= 90%
        Camera -> Camera : Desenha bounding box
        Camera -> Monitor : onDetection({ material, confidence, bbox })
        activate Monitor
        Monitor -> Monitor : Identifica cancela correta\n(baseado em gateConfigs)
        Monitor -> Monitor : Ativa cancela visual
        Monitor --> Camera : ok
        deactivate Monitor
      end
    end
    deactivate ONNX
    
  else Fallback: Servidor Python
    Camera -> Server : POST /inference\n{ imageBase64 }
    activate Server
    Server -> Server : Chama Python inference_server.py
    Server --> Camera : { detections: [...] }
    deactivate Server
    Camera -> Monitor : onDetection({ material, confidence, bbox })
    activate Monitor
    Monitor -> Monitor : Ativa cancela
    deactivate Monitor
  end
  
  deactivate Camera
  deactivate Monitor
end

' ==================== FLUXO 4: DASHBOARD ====================

group 4. Visualização de Estatísticas

  User -> Sidebar : Seleciona aba "Dashboard"
  activate Sidebar
  Sidebar -> App : onTabChange("dashboard")
  deactivate Sidebar
  activate App
  App -> StatsPanel : Renderiza componente
  deactivate App
  activate StatsPanel
  
  StatsPanel -> Server : GET /stats?userId=user123
  activate Server
  
  alt Modo Demo
    Server --> StatsPanel : Mock data (estatísticas demo)
  else Modo OAuth
    Server -> KV : getByPrefix("detection_user123_")
    activate KV
    KV --> Server : detections[]
    deactivate KV
    Server -> Server : Agrega estatísticas por material
    Server --> StatsPanel : { totalDetections, byMaterial, timeline }
  end
  
  deactivate Server
  
  StatsPanel -> StatsPanel : Renderiza gráficos (Recharts)
  StatsPanel --> User : Exibe dashboard
  deactivate StatsPanel
  
end

' ==================== FLUXO 5: PERFIL ====================

group 5. Perfil do Usuário

  User -> Sidebar : Seleciona aba "Perfil"
  activate Sidebar
  Sidebar -> App : onTabChange("perfil")
  deactivate Sidebar
  activate App
  App -> Profile : Renderiza componente
  deactivate App
  activate Profile
  
  Profile -> Server : GET /user/stats?userId=user123
  activate Server
  
  alt Modo Demo
    Server --> Profile : { totalSessions: 0, totalDetections: 0 }
  else Modo OAuth
    Server -> KV : getByPrefix("session_user123_")
    activate KV
    KV --> Server : sessions[]
    deactivate KV
    Server -> KV : getByPrefix("detection_user123_")
    activate KV
    KV --> Server : detections[]
    deactivate KV
    Server -> Server : Calcula estatísticas
    Server --> Profile : { totalSessions, totalDetections, lastSession, ... }
  end
  
  deactivate Server
  
  Profile --> User : Exibe perfil e estatísticas
  deactivate Profile
  
end

' ==================== FLUXO 6: LOGOUT ====================

group 6. Logout

  User -> Sidebar : Clica "Logout"
  activate Sidebar
  Sidebar -> App : onLogout()
  deactivate Sidebar
  activate App
  
  alt Modo Demo
    App -> App : setUser(null)\nsetIsDemoMode(false)
  else OAuth
    App -> Auth : signOut()
    activate Auth
    Auth --> App : success
    deactivate Auth
    App -> App : setUser(null)
  end
  
  App -> Login : Renderiza tela de login
  deactivate App
  
end

@enduml
