MonitorPanel --> Badge
MonitorPanel --> Button
Camera --> Card
Camera --> Button
GateConfig --> Card
GateConfig --> Select
GateConfig --> Button
AccuracyCtrl --> Card
AccuracyCtrl --> Slider
AccuracyCtrl --> Select
StatsPanel --> Card
StatsPanel --> Chart
UserProfile --> Card
UserProfile --> Avatar
Sidebar --> Avatar
Sidebar --> Button
Login --> Button

