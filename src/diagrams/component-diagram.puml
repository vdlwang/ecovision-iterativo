@startuml EcoVision - Diagrama de Componentes React
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 12
skinparam componentStyle rectangle

title EcoVision - Estrutura de Componentes React e Props

' ==================== APP PRINCIPAL ====================

package "Root Application" #034732 {
  
  [App.tsx] as App #ABF2AB
  
  note right of App
    **Estado Global:**
    • user: User | null
    • userToken: string | null
    • isDemoMode: boolean
    • activeTab: "monitor" | "cancelas" | "modelo" | "dashboard" | "perfil"
    • isSystemRunning: boolean
    • minAccuracy: number (default: 85)
    • modelVersion: "YOLOv8n" | "YOLOv8s" | "YOLOv8m"
    • gateConfigs: { 1: string, 2: string, 3: string }
    
    **Handlers:**
    • handleDemoMode()
    • handleToggleSystem()
    • handleAccuracyChange(accuracy)
    • handleModelVersionChange(version)
    • handleGateConfigChange(configs)
  end note
}

' ==================== AUTENTICAÇÃO ====================

package "Authentication" #E8F4FD {
  component "Login.tsx" as Login {
    **Props:**
    • onDemoMode?: () => void
    
    **State:**
    • isLoading: boolean
    
    **Methods:**
    • handleGoogleLogin()
    • handleDemoMode()
  }
}

' ==================== NAVEGAÇÃO ====================

package "Navigation" #ABF2AB {
  component "Sidebar.tsx" as Sidebar {
    **Props:**
    • activeTab: string
    • onTabChange: (tab) => void
    • userEmail: string
    • onLogout: () => void
    
    **Features:**
    • Menu expansível
    • 5 abas: Monitor, Cancelas, Modelo, Dashboard, Perfil
    • Avatar do usuário
    • Botão de logout
  }
}

' ==================== ABA MONITOR ====================

package "Monitor Tab" #EDFEF4 {
  component "MonitorPanel.tsx" as MonitorPanel {
    **Props:**
    • gateConfigs: { [key: number]: string }
    • minAccuracy: number
    • isRunning: boolean
    • onToggleSystem: () => void
    • modelVersion: string
    • userId: string
    • userToken: string | null
    
    **Layout:**
    • Card único com 2 colunas
    • Coluna esquerda: Câmera
    • Coluna direita: Esteira + Cancelas
    
    **Features:**
    • Controle da esteira (Start/Stop)
    • Visualização animada do transportador
    • 3 cancelas com cores de materiais
    • Detecções recentes
  }
  
  component "CameraFeed.tsx" as Camera {
    **Props:**
    • isRunning: boolean
    • onDetection: (detection) => void
    • modelVersion: string
    • minConfidence: number
    • onToggleSystem: () => void
    • inline: boolean
    • userToken: string | null
    
    **State:**
    • videoRef: RefObject<HTMLVideoElement>
    • canvasRef: RefObject<HTMLCanvasElement>
    • detections: Detection[]
    • fps: number
    • cameraError: string | null
    
    **Features:**
    • Captura webcam em tempo real
    • Inferência ONNX local (prioritária)
    • Fallback para servidor Python
    • Desenha bounding boxes
    • Exibe FPS e confiança
    • Botão Start/Stop sistema
  }
}

' ==================== ABA CONFIGURAÇÃO ====================

package "Configuration Tab" #FEF4ED {
  component "GateConfiguration.tsx" as GateConfig {
    **Props:**
    • gateConfigs: { [key: number]: string }
    • onConfigChange: (configs) => void
    • isSystemRunning: boolean
    
    **State:**
    • tempConfigs: { [key: number]: string }
    
    **Features:**
    • 3 selects para materiais
    • Visualização de cores
    • Salvar configuração
    • Bloqueio quando sistema ativo
  }
}

' ==================== ABA MODELO ====================

package "Model Tab" #FFF9E8 {
  component "AccuracyControl.tsx" as AccuracyCtrl {
    **Props:**
    • minAccuracy: number
    • onAccuracyChange: (accuracy) => void
    • isSystemRunning: boolean
    • modelVersion: string
    • onModelVersionChange: (version) => void
    
    **State:**
    • tempAccuracy: number
    
    **Features:**
    • Slider de confiança (50-95%)
    • Seletor de modelo YOLO
    • Informações de performance
    • Bloqueio quando sistema ativo
  }
}

' ==================== ABA DASHBOARD ====================

package "Statistics Tab" #E8F4FD {
  component "StatisticsPanel.tsx" as StatsPanel {
    **Props:**
    • isSystemRunning: boolean
    • gateConfigs: { [key: number]: string }
    • userToken: string | null
    
    **State:**
    • stats: StatisticsData
    • loading: boolean
    • timeRange: "24h" | "7d" | "30d"
    
    **Features:**
    • Gráficos de detecções (Recharts)
    • Métricas por material
    • Histórico de detecções
    • Filtros de período
  }
}

' ==================== ABA PERFIL ====================

package "Profile Tab" #ABF2AB {
  component "UserProfile.tsx" as UserProfile {
    **Props:**
    • user: User
    • isDemoMode: boolean
    • userToken: string | null
    
    **State:**
    • userStats: UserStatistics
    • loading: boolean
    
    **Features:**
    • Informações do usuário
    • Total de sessões
