@startuml EcoVision - Diagrama de Banco de Dados
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 12
skinparam linetype ortho

title EcoVision - Modelo de Dados (PostgreSQL + Supabase)

' ==================== ESQUEMA DE CORES ====================
' Verde: Tabelas principais
' Azul: Tabelas de autenticação (Supabase Auth)
' Amarelo: Tabelas de sistema/config
' Vermelho: Tabelas de logs/auditoria

' ==================== SUPABASE AUTH (Gerenciado) ====================

package "Supabase Auth (Gerenciado pelo Supabase)" #E8F4FD {
  
  entity "auth.users" as auth_users {
    **Gerenciado pelo Supabase**
    --
    * id : uuid <<PK>>
    --
    email : varchar
    encrypted_password : varchar
    email_confirmed_at : timestamp
    created_at : timestamp
    updated_at : timestamp
    last_sign_in_at : timestamp
    raw_app_meta_data : jsonb
    raw_user_meta_data : jsonb
    is_super_admin : boolean
    role : varchar
  }
  
  note right of auth_users
    **Tabela gerenciada pelo Supabase Auth**
    Não modificar diretamente!
    
    Populada automaticamente via:
    • Google OAuth
    • Email/Password
    • Outros providers
    
    Campos importantes:
    • id: UUID do usuário
    • email: Email único
    • raw_user_meta_data: JSON com nome, avatar, etc.
  end note
}

' ==================== TABELAS CUSTOMIZADAS ====================

package "Schema Public (Customizado)" #EDFEF4 {
  
  ' ==================== TABELA DE PERFIS ====================
  
  entity "profiles" as profiles {
    **Perfil do Usuário**
    --
    * id : uuid <<PK, FK>>
    --
    full_name : varchar(255)
    avatar_url : text
    phone : varchar(20)
    company : varchar(255)
    role : varchar(100)
    preferences : jsonb
    total_sessions : integer
    last_session_at : timestamp
    created_at : timestamp
    updated_at : timestamp
  }
  
  note right of profiles
    **Dados adicionais do usuário**
    
    • id: Referência ao auth.users(id)
    • full_name: Nome completo
    • avatar_url: URL do avatar
    • preferences: Configurações do usuário
      {
        "theme": "light",
        "notifications": true,
        "default_model": "YOLOv8n"
      }
    • total_sessions: Contador de sessões
    
    **RLS Habilitado:**
    - Usuário só acessa próprio perfil
  end note
  
  ' ==================== TABELA DE SESSÕES ====================
  
  entity "user_sessions" as sessions {
    **Sessões do Usuário**
    --
    * id : uuid <<PK>>
    --
    user_id : uuid <<FK>>
    session_token : varchar(255)
    started_at : timestamp
    ended_at : timestamp
    duration_seconds : integer
    ip_address : varchar(45)
    user_agent : text
    device_info : jsonb
    inferences_count : integer
    created_at : timestamp
  }
  
  note left of sessions
    **Rastreamento de sessões**
    
    • session_token: Token único da sessão
    • duration_seconds: Duração calculada
    • inferences_count: Total de inferências
    • device_info: JSON com dados do dispositivo
      {
        "browser": "Chrome 120",
        "os": "Windows 10",
        "screen": "1920x1080"
      }
    
    **Triggers:**
    - Auto-calcular duration ao definir ended_at
    - Auto-incrementar total_sessions em profiles
  end note
  
  ' ==================== TABELA DE INFERÊNCIAS ====================
  
  entity "inferences" as inferences {
    **Inferências Realizadas**
    --
    * id : bigserial <<PK>>
    --
    user_id : uuid <<FK>>
    session_id : uuid <<FK>>
    material_detected : varchar(50)
    confidence : decimal(5,2)
    gate_number : integer
    gate_activated : boolean
    model_version : varchar(20)
    processing_time_ms : integer
    image_url : text
    bounding_box : jsonb
    timestamp : timestamp
    created_at : timestamp
  }
  
  note right of inferences
    **Registro de cada detecção**
    
    • material_detected: 
      "papel", "metal", "plastico", "vidro"
    
    • confidence: 0.00 a 100.00
      Ex: 92.50 = 92.5% de confiança
    
    • gate_number: 1, 2 ou 3
    
    • gate_activated: TRUE se acionou
      (depende de confidence >= threshold)
    
    • bounding_box: Coordenadas do box
      {
        "x": 120,
        "y": 80,
        "width": 200,
        "height": 150
      }
    
    • processing_time_ms: Tempo de inferência
    
    **Índices:**
    - idx_user_timestamp
    - idx_session_id
    - idx_material_detected
  end note
  
  ' ==================== TABELA DE CONFIGURAÇÕES ====================
  
  entity "system_config" as config {
    **Configurações do Sistema**
    --
    * id : serial <<PK>>
    --
    user_id : uuid <<FK>>
    gate_1_material : varchar(50)
    gate_2_material : varchar(50)
    gate_3_material : varchar(50)
    min_confidence : integer
    model_version : varchar(20)
    auto_start : boolean
    notification_enabled : boolean
    config_data : jsonb
    is_active : boolean
    created_at : timestamp
    updated_at : timestamp
  }
  
  note left of config
    **Configurações por usuário**
    
    • gate_X_material: Material de cada cancela
    • min_confidence: 50-100 (padrão: 85)
    • model_version: "YOLOv8n", "YOLOv8s", "YOLOv8m"
    • config_data: Configurações extras em JSON
    
    **Unique constraint:**
    - (user_id, is_active) onde is_active = true
    - Apenas 1 config ativa por usuário
  end note
  
  ' ==================== TABELA DE ESTATÍSTICAS ====================
  
  entity "statistics" as stats {
    **Estatísticas Agregadas**
    --
    * id : serial <<PK>>
    --
    user_id : uuid <<FK>>
    session_id : uuid <<FK>>
    date : date
    total_inferences : integer
    papel_count : integer
    metal_count : integer
    plastico_count : integer
    vidro_count : integer
    gate_1_count : integer
    gate_2_count : integer
    gate_3_count : integer
    avg_confidence : decimal(5,2)
    avg_processing_time_ms : integer
    created_at : timestamp
    updated_at : timestamp
  }
  
  note right of stats
    **Agregação diária de dados**
    
    Atualizada via trigger ou job:
    • A cada inferência (trigger)
    • Diariamente à meia-noite (cron job)
    
    **Unique constraint:**
    - (user_id, date)
    - Uma linha por usuário por dia
    
    Facilita queries do dashboard
    sem processar todas as inferências
  end note
  
  ' ==================== TABELA DE LOGS ====================
  
  entity "system_logs" as logs {
    **Logs do Sistema**
    --
    * id : bigserial <<PK>>
    --
    user_id : uuid <<FK>>
    session_id : uuid <<FK>>
    log_level : varchar(20)
    log_type : varchar(50)
    message : text
    details : jsonb
    stack_trace : text
    ip_address : varchar(45)
    timestamp : timestamp
    created_at : timestamp
  }
  
  note left of logs
    **Auditoria e debugging**
    
    • log_level: 
      "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
    
    • log_type:
      "AUTH", "INFERENCE", "SYSTEM", "HARDWARE"
    
    • details: JSON com contexto
      {
        "endpoint": "/modelo/processar",
        "response_time_ms": 234,
        "error_code": null
      }
    
    **Retenção:**
    - DEBUG/INFO: 7 dias
    - WARNING: 30 dias
    - ERROR/CRITICAL: 90 dias
  end note
  
  ' ==================== TABELA KV_STORE (Existente) ====================
  
  entity "kv_store_ea835390" as kv_store {
    **Key-Value Store (Legado)**
    --
    * key : varchar(255) <<PK>>
    --
    value : jsonb
    created_at : timestamp
    updated_at : timestamp
  }
  
  note right of kv_store
    **Armazenamento genérico**
    
    Usado para:
    • Cache temporário
    • Configurações rápidas
    • Dados não estruturados
    
    Prefixos de chaves:
    • "system_config"
    • "detection_{timestamp}"
    • "log_{timestamp}"
    • "session_{id}"
    
    **Migração planejada:**
    Mover dados para tabelas estruturadas
  end note
}

' ==================== RELACIONAMENTOS ====================

auth_users ||--o{ profiles : "1:1 (obrigatório)"
auth_users ||--o{ sessions : "1:N"
auth_users ||--o{ inferences : "1:N"
auth_users ||--o{ config : "1:N"
auth_users ||--o{ stats : "1:N"
auth_users ||--o{ logs : "1:N"

profiles ||--o{ sessions : "1:N"
sessions ||--o{ inferences : "1:N"
sessions ||--o{ stats : "1:1 (opcional)"
sessions ||--o{ logs : "1:N"

config }o--|| profiles : "N:1 (config ativa)"

' ==================== CONSTRAINTS E ÍNDICES ====================

note top of profiles
  **CONSTRAINTS:**
  • PK: id (uuid)
  • FK: id → auth.users(id) ON DELETE CASCADE
  • UNIQUE: id
  
  **ÍNDICES:**
  • idx_profiles_id (PK automático)
  • idx_profiles_updated_at
  
  **RLS (Row Level Security):**
  • SELECT: auth.uid() = id
  • UPDATE: auth.uid() = id
  • INSERT: auth.uid() = id
  • DELETE: auth.uid() = id
end note

note top of sessions
  **CONSTRAINTS:**
  • PK: id (uuid)
  • FK: user_id → auth.users(id) ON DELETE CASCADE
  • CHECK: ended_at IS NULL OR ended_at > started_at
  • CHECK: inferences_count >= 0
  
  **ÍNDICES:**
  • idx_sessions_user_id
  • idx_sessions_started_at
  • idx_sessions_token UNIQUE
  
  **TRIGGERS:**
  • before_session_end: Calcula duration_seconds
  • after_session_end: Incrementa profiles.total_sessions
end note

note top of inferences
  **CONSTRAINTS:**
  • PK: id (bigserial)
  • FK: user_id → auth.users(id) ON DELETE CASCADE
  • FK: session_id → user_sessions(id) ON DELETE SET NULL
  • CHECK: confidence >= 0 AND confidence <= 100
  • CHECK: gate_number IN (1, 2, 3)
  • CHECK: material_detected IN ('papel', 'metal', 'plastico', 'vidro')
  
  **ÍNDICES:**
  • idx_inferences_user_timestamp (user_id, timestamp DESC)
  • idx_inferences_session_id
  • idx_inferences_material
  • idx_inferences_timestamp
  
  **PARTICIONAMENTO (futuro):**
  • Por timestamp (mensal)
  • Para melhor performance em grandes volumes
end note

note bottom of config
  **CONSTRAINTS:**
  • PK: id (serial)
  • FK: user_id → auth.users(id) ON DELETE CASCADE
  • UNIQUE: (user_id, is_active) WHERE is_active = true
  • CHECK: min_confidence >= 50 AND min_confidence <= 100
  • CHECK: model_version IN ('YOLOv8n', 'YOLOv8s', 'YOLOv8m')
  
  **ÍNDICES:**
  • idx_config_user_active (user_id, is_active)
  
  **DEFAULT VALUES:**
  • min_confidence: 85
  • model_version: 'YOLOv8n'
  • auto_start: false
  • notification_enabled: true
end note

note bottom of stats
  **CONSTRAINTS:**
  • PK: id (serial)
  • FK: user_id → auth.users(id) ON DELETE CASCADE
  • FK: session_id → user_sessions(id) ON DELETE SET NULL
  • UNIQUE: (user_id, date)
  • CHECK: avg_confidence >= 0 AND avg_confidence <= 100
  
  **ÍNDICES:**
  • idx_stats_user_date UNIQUE (user_id, date)
  • idx_stats_date
  
  **TRIGGERS:**
  • after_inference_insert: Atualiza contadores
  
  **MATERIALIZED VIEW (futuro):**
  • mv_monthly_stats: Agregação mensal
  • REFRESH CONCURRENTLY diariamente
end note

' ==================== VIEWS ====================

package "Views e Materialized Views" #FFF9E8 {
  
  component "v_user_dashboard" as v_dashboard {
    **View: Dashboard do Usuário**
    --
    SELECT
      u.id,
      p.full_name,
      p.total_sessions,
      COUNT(DISTINCT s.id) as active_sessions,
      COUNT(i.id) as total_inferences,
      AVG(i.confidence) as avg_confidence
    FROM auth.users u
    JOIN profiles p ON u.id = p.id
    LEFT JOIN user_sessions s ON u.id = s.user_id
    LEFT JOIN inferences i ON u.id = i.user_id
    WHERE s.ended_at IS NULL
    GROUP BY u.id, p.full_name
  }
  
  component "v_session_summary" as v_session {
    **View: Resumo de Sessão**
    --
    SELECT
      s.id,
      s.user_id,
      s.started_at,
      s.ended_at,
      COUNT(i.id) as inferences_count,
      AVG(i.confidence) as avg_confidence,
      SUM(CASE WHEN i.gate_activated THEN 1 ELSE 0 END) as activations_count
    FROM user_sessions s
    LEFT JOIN inferences i ON s.id = i.session_id
    GROUP BY s.id
  }
  
  component "v_material_stats" as v_material {
    **View: Estatísticas por Material**
    --
    SELECT
      user_id,
      material_detected,
      DATE(timestamp) as date,
      COUNT(*) as count,
      AVG(confidence) as avg_confidence,
      MIN(confidence) as min_confidence,
      MAX(confidence) as max_confidence
    FROM inferences
    GROUP BY user_id, material_detected, DATE(timestamp)
  }
}

' ==================== FUNÇÕES E TRIGGERS ====================

package "Functions & Triggers" #DC1F2E {
  
  component "fn_create_profile()" as fn_profile {
    **Function: Criar Perfil**
    --
    Trigger: AFTER INSERT ON auth.users
    
    BEGIN
      INSERT INTO profiles (id, full_name)
      VALUES (
        NEW.id,
        NEW.raw_user_meta_data->>'name'
      );
    END;
  }
  
  component "fn_update_session_duration()" as fn_duration {
    **Function: Atualizar Duração**
    --
    Trigger: BEFORE UPDATE ON user_sessions
    
    BEGIN
      IF NEW.ended_at IS NOT NULL THEN
        NEW.duration_seconds := 
          EXTRACT(EPOCH FROM 
            (NEW.ended_at - NEW.started_at)
          );
      END IF;
      RETURN NEW;
    END;
  }
  
  component "fn_increment_session_counter()" as fn_counter {
    **Function: Incrementar Contador**
    --
    Trigger: AFTER UPDATE ON user_sessions
    
    BEGIN
      IF NEW.ended_at IS NOT NULL 
         AND OLD.ended_at IS NULL THEN
        UPDATE profiles
        SET total_sessions = total_sessions + 1,
            last_session_at = NEW.ended_at
        WHERE id = NEW.user_id;
      END IF;
    END;
  }
  
  component "fn_update_statistics()" as fn_stats {
    **Function: Atualizar Estatísticas**
    --
    Trigger: AFTER INSERT ON inferences
    
    BEGIN
      INSERT INTO statistics (
        user_id, date, total_inferences, ...
      ) VALUES (
        NEW.user_id, DATE(NEW.timestamp), 1, ...
      )
      ON CONFLICT (user_id, date)
      DO UPDATE SET
        total_inferences = statistics.total_inferences + 1,
        [material]_count = CASE 
          WHEN NEW.material_detected = '[material]' 
          THEN statistics.[material]_count + 1 
          ELSE statistics.[material]_count 
        END;
    END;
  }
}

auth_users --> fn_profile : "AFTER INSERT"
sessions --> fn_duration : "BEFORE UPDATE"
sessions --> fn_counter : "AFTER UPDATE"
inferences --> fn_stats : "AFTER INSERT"

' ==================== LEGENDA ====================

legend right
  **Tipos de Dados:**
  • uuid: Identificador único universal
  • bigserial: Auto-incremento (64-bit)
  • serial: Auto-incremento (32-bit)
  • varchar(n): String com limite
  • text: String sem limite
  • jsonb: JSON binário (indexável)
  • decimal(5,2): Número decimal (ex: 92.50)
  • integer: Número inteiro
  • boolean: true/false
  • timestamp: Data e hora
  • date: Apenas data
  
  **Relacionamentos:**
  ||--o{ : Um para muitos
  ||--|| : Um para um
  }o--|| : Muitos para um
  
  **Constraints:**
  • PK: Primary Key
  • FK: Foreign Key
  • UNIQUE: Valor único
  • CHECK: Validação customizada
  
  **Cores:**
  |<#E8F4FD>  | Supabase Auth (gerenciado) |
  |<#EDFEF4>  | Tabelas customizadas |
  |<#FFF9E8>  | Views e queries |
  |<#DC1F2E>  | Functions e triggers |
endlegend

