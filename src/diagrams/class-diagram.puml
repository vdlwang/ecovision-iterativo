@startuml EcoVision - Diagrama de Classes Simplificado
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0

title EcoVision - Diagrama de Classes (Frontend + Backend)

' ==================== FRONTEND COMPONENTS ====================

package "Frontend React Components" #EDFEF4 {
  
  class App <<Component>> {
    - user: User | null
    - userToken: string | null
    - isDemoMode: boolean
    - loading: boolean
    - activeTab: string
    - isSystemRunning: boolean
    - minAccuracy: number
    - modelVersion: string
    - gateConfigs: Map<number, string>
    --
    + handleDemoMode(): void
    + handleToggleSystem(): void
    + handleAccuracyChange(accuracy: number): void
    + handleModelVersionChange(version: string): void
    + handleGateConfigChange(configs: object): void
    --
    **Gerencia estado global**
    **Renderiza componentes baseado em activeTab**
  }
  
  class Login <<Component>> {
    - isLoading: boolean
    --
    + handleGoogleLogin(): Promise<void>
    + handleDemoMode(): void
    --
    **Props:**
    • onDemoMode: () => void
  }
  
  class Sidebar <<Component>> {
    --
    **Props:**
    • activeTab: string
    • onTabChange: (tab) => void
    • userEmail: string
    • onLogout: () => void
    --
    **Features:**
    • Menu expansível
    • 5 abas navegáveis
    • Avatar do usuário
  }
  
  class MonitorPanel <<Component>> {
    - recentDetections: Detection[]
    - gateStates: GateStates
    - beltRunning: boolean
    --
    + handleCameraDetection(detection): void
    + activateGate(gateNumber): void
    + sendSerialCommand(gateNumber): void
    + saveDetection(detection, userId): void
    --
    **Props:**
    • gateConfigs: object
    • minAccuracy: number
    • isRunning: boolean
    • onToggleSystem: () => void
    • modelVersion: string
    • userId: string
    • userToken: string
  }
  
  class CameraFeed <<Component>> {
    - videoRef: RefObject<HTMLVideoElement>
    - canvasRef: RefObject<HTMLCanvasElement>
    - detections: Detection[]
    - fps: number
    - cameraError: string | null
    - inferenceMode: "onnx" | "server" | "mock"
    --
    + startCamera(): Promise<void>
    + stopCamera(): void
    + processFrame(): void
    + drawBoundingBoxes(): void
    + runONNXInference(imageData): Promise<Detection[]>
    + runServerInference(imageData): Promise<Detection[]>
    --
    **Props:**
    • isRunning: boolean
    • onDetection: (detection) => void
    • modelVersion: string
    • minConfidence: number
    • onToggleSystem: () => void
    • inline: boolean
    • userToken: string
  }
  
  class GateConfiguration <<Component>> {
    - tempConfigs: Map<number, string>
    --
    + handleConfigSave(): void
    --
    **Props:**
    • gateConfigs: object
    • onConfigChange: (configs) => void
    • isSystemRunning: boolean
  }
  
  class AccuracyControl <<Component>> {
    - tempAccuracy: number
    --
    + handleAccuracySave(): void
    + handleModelChange(version): void
    --
    **Props:**
    • minAccuracy: number
    • onAccuracyChange: (accuracy) => void
    • isSystemRunning: boolean
    • modelVersion: string
    • onModelVersionChange: (version) => void
  }
  
  class StatisticsPanel <<Component>> {
    - stats: StatisticsData
    - loading: boolean
    - timeRange: string
    --
    + fetchStats(): Promise<void>
    + renderCharts(): JSX.Element
    --
    **Props:**
    • isSystemRunning: boolean
    • gateConfigs: object
    • userToken: string
  }
  
  class UserProfile <<Component>> {
    - userStats: UserStatistics
    - loading: boolean
    --
    + fetchUserStats(): Promise<void>
    --
    **Props:**
    • user: User
    • isDemoMode: boolean
    • userToken: string
  }
}

' ==================== FRONTEND UTILS ====================

package "Frontend Utils" #ABF2AB {
  
  class ONNXInference <<Utility>> {
    + loadONNXModel(modelPath: string): Promise<InferenceSession>
    + runInference(session, imageData): Promise<Tensor>
    + preprocessImage(imageData): Tensor
    + postprocessYOLOOutput(output): Detection[]
    + applyNMS(detections, threshold): Detection[]
    --
    **Inferência ONNX no navegador**
    **Zero latência de rede**
  }
  
  class SupabaseClient <<Utility>> {
    - client: SupabaseClient | null
    --
    + getSupabaseClient(): SupabaseClient
    + createClient(): SupabaseClient
    --
    **Singleton do cliente Supabase**
  }
}

' ==================== BACKEND API ====================

package "Backend Hono Server" #FEF4ED {
  
  class HonoServer <<API>> {
    - app: Hono
    - supabase: SupabaseClient
    --
    + GET /health
    + GET /auth-test
    + POST /config
    + GET /config
    + POST /inference
    + GET /stats
    + GET /stats/period
    + POST /session/end
    + POST /logs
    + GET /logs
    + GET /user/stats
    --
    **Middleware:**
    • CORS
    • Logger
    • JWT Auth
  }
  
  note right of HonoServer
    **Autenticação:**
    • Suporta Google OAuth (JWT)
    • Suporta Modo Demo (token especial)
    • Valida tokens em cada request
    
    **CORS:**
    • Origin: *
    • Methods: GET, POST, PUT, DELETE
    • Headers: Content-Type, Authorization
  end note
}

' ==================== DATABASE ====================

package "Supabase Database" #E8F4FD {
  
  class KVStore <<Persistence>> {
    --
    + get(key: string): Promise<any>
    + set(key: string, value: any): Promise<void>
    + mget(keys: string[]): Promise<any[]>
    + mset(entries: object): Promise<void>
    + del(key: string): Promise<void>
    + mdel(keys: string[]): Promise<void>
    + getByPrefix(prefix: string): Promise<any[]>
    --
    **Table: kv_store_ea835390**
    • key: TEXT (PK)
    • value: JSONB
    • created_at: TIMESTAMP
    • updated_at: TIMESTAMP
  }
  
  note right of KVStore
    **Chaves Usadas:**
    • system_config_{userId}
    • detection_{userId}_{timestamp}
    • stats_{userId}_{date}
    • session_{sessionId}
    • user_profile_{userId}
    • inference_{requestId}
  end note
}

package "Supabase Auth" #E8F4FD {
  
  class SupabaseAuth <<Service>> {
    --
    + signInWithOAuth(provider): Promise<Session>
    + signOut(): Promise<void>
    + getSession(): Promise<Session>
    + getUser(token): Promise<User>
    + onAuthStateChange(callback): Subscription
    --
    **Providers:**
    • Google OAuth
    • Demo Mode (custom)
  }
}

' ==================== EXTERNAL SERVICES ====================

package "External Services" #FFF9E8 {
  
  class ONNXRuntimeWeb <<Service>> {
    --
    + InferenceSession.create(modelPath): Promise<Session>
    + session.run(feeds): Promise<Tensor>
    --
    **Modelos:**
    • yolov8n.onnx (~12MB)
    • yolov8s.onnx (~45MB)
    • yolov8m.onnx (~100MB)
  }
  
  class PythonInferenceServer <<Service>> {
    --
    + POST /predict
    + GET /health
    --
    **Framework:** FastAPI
    **Modelos:** .pt files
    **Opcional:** Fallback quando ONNX falha
  }
  
  class WebcamAPI <<Browser API>> {
    --
    + getUserMedia(constraints): Promise<MediaStream>
    --
    **Constraints:**
    • video: { width: 640, height: 480, facingMode: "environment" }
  }
}

' ==================== DOMAIN MODELS ====================

package "Domain Models" #008148 {
  
  class Detection <<Model>> {
    + material: string
    + confidence: number
    + bbox: BoundingBox
    + timestamp: Date
    + gateAssigned: number
  }
  
  class BoundingBox <<Model>> {
    + x: number
    + y: number
    + width: number
    + height: number
  }
  
  class User <<Model>> {
    + id: string
    + email: string
    + name?: string
    + avatar_url?: string
  }
  
  class StatisticsData <<Model>> {
    + totalDetections: number
    + byMaterial: Map<string, number>
    + timeline: TimelinePoint[]
    + averageConfidence: number
  }
  
  class UserStatistics <<Model>> {
    + totalSessions: number
    + totalDetections: number
    + totalProcessed: number
    + lastSession: Date | null
    + favoriteConfiguration: object | null
  }
  
  class GateConfig <<Model>> {
    + gate1Material: string
    + gate2Material: string
    + gate3Material: string
    + minConfidence: number
    + modelVersion: string
  }
}

' ==================== RELATIONSHIPS ====================

' App para Components
App *-- Login : "renderiza quando !user"
App *-- Sidebar : "renderiza quando user"
App *-- MonitorPanel : "renderiza quando activeTab=monitor"
App *-- GateConfiguration : "renderiza quando activeTab=cancelas"
App *-- AccuracyControl : "renderiza quando activeTab=modelo"
App *-- StatisticsPanel : "renderiza quando activeTab=dashboard"
App *-- UserProfile : "renderiza quando activeTab=perfil"

' MonitorPanel composição
MonitorPanel *-- CameraFeed : "contém"

' Components usam Utils
CameraFeed --> ONNXInference : "usa para inferência local"
App --> SupabaseClient : "usa para auth"
Login --> SupabaseClient : "usa para OAuth"

' Components usam API
MonitorPanel --> HonoServer : "HTTP requests"
CameraFeed --> HonoServer : "POST /inference (fallback)"
GateConfiguration --> HonoServer : "POST /config"
AccuracyControl --> HonoServer : "POST /config"
StatisticsPanel --> HonoServer : "GET /stats"
UserProfile --> HonoServer : "GET /user/stats"

' API usa Database
HonoServer --> KVStore : "persiste dados"
HonoServer --> SupabaseAuth : "valida tokens"

' External Services
CameraFeed --> WebcamAPI : "captura vídeo"
CameraFeed --> ONNXRuntimeWeb : "inferência local"
CameraFeed --> PythonInferenceServer : "fallback inferência"
ONNXInference --> ONNXRuntimeWeb : "carrega modelo"

' Domain Models
Detection *-- BoundingBox
StatisticsData *-- Detection
UserStatistics --> User
GateConfig --> User
MonitorPanel --> Detection : "processa"
CameraFeed --> Detection : "cria"
StatisticsPanel --> StatisticsData : "exibe"
UserProfile --> UserStatistics : "exibe"

